# Copy to .env for local development. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Use a separate database per environment
# (e.g. packstack_dev, packstack_staging, packstack_prod) - never point a
# dev machine at the production database.
MONGODB_URI=mongodb://127.0.0.1:27017/packstack_dev

# Base domain tenants are resolved under, e.g. <slug>.packstack.co.za in prod.
# In local dev, tenant slug is read from the URL path (/api/t/:slug/...), so
# this is only used to validate custom-domain mappings and build links.
BASE_DOMAIN=packstack.co.za

# JWT signing secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Access and refresh MUST use different secrets so a leaked access-token
# secret can't be used to mint refresh tokens.
JWT_ACCESS_SECRET=replace-with-a-64-byte-random-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Separate secret for superadmin (platform) tokens so a bug in tenant-token
# verification can never accidentally validate a superadmin token.
JWT_SUPERADMIN_SECRET=replace-with-yet-another-64-byte-random-hex-string

# Separate secret for customer account tokens (signup/login/profile) so a bug
# in customer-token verification can never accidentally validate a staff or
# superadmin token, same reasoning as JWT_SUPERADMIN_SECRET above.
JWT_CUSTOMER_SECRET=replace-with-yet-another-64-byte-random-hex-string

# Signs the customer-facing "manage your booking" link (view/reschedule/cancel
# with no login). Its own secret since this token is handed to a customer
# over WhatsApp/email, unlike the server-side-only tokens above.
APPOINTMENT_LINK_SECRET=replace-with-yet-another-64-byte-random-hex-string

# PayFast bills tenants for their PackStack subscription (platform-level -
# not Yoco, which stays each tenant's own end-customer payment rail via
# IntegrationCredential). Optional: routes needing it fail clearly if unset,
# rather than the whole server refusing to boot.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# This server's own public URL, so PayFast's ITN webhook can reach back to
# it. Point this at an ngrok (or similar) tunnel for local end-to-end testing
# against PayFast's sandbox checkout.
API_BASE_URL=http://localhost:4000

# Master key for envelope-encrypting per-tenant integration credentials
# (WATI, Yoco). 32 bytes, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key requires re-encrypting all IntegrationCredential rows -
# treat it like a production secret, store it only in Render's dashboard.
SECRETS_MASTER_KEY=replace-with-a-32-byte-base64-key

# Comma-separated list of extra allowed CORS origins beyond *.packstack.co.za
# (e.g. for a staging frontend deployed on a vercel.app preview URL, or the
# marketing site at https://packstack.co.za / https://www.packstack.co.za,
# which calls GET /api/public/plans from the browser to render pricing).
CORS_EXTRA_ORIGINS=https://packstack.co.za,https://www.packstack.co.za

# Optional: Redis URL for distributed rate limiting once running more than
# one backend instance. Leave unset to use the in-memory limiter (fine for
# a single instance / local dev).
REDIS_URL=

# Powers tenant branding image uploads (Settings > Branding > logo/banner).
# One Cloudinary account for the whole platform - each tenant's assets live
# under their own packstack/<tenantId>/ prefix, not per-tenant credentials.
# Free tier is enough to start: https://cloudinary.com/users/register/free
# Optional: the upload routes fail with a clear error if unset, same as
# PayFast above, rather than the whole server refusing to boot.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
